   ) ;

  ALTER TABLE "TB_INVESTIGADOR_ARMA" ADD FOREIGN KEY ("ID_INVESTIGADOR")
	  REFERENCES "TB_INVESTIGADOR" ("ID_INVESTIGADOR") ON DELETE CASCADE ENABLE;

=========================
TABELA INVESTIGADOR PERICIA
=========================
  CREATE TABLE "TB_INVESTIGADOR_PERICIA" 
   (	"ID_INVESTIGADOR" NUMBER, 
	"ID_PERICIA" NUMBER, 
	"PONTOS_ALOCADOS" NUMBER DEFAULT 0, 
	"MARCADOR_EVOLUCAO" NUMBER(1,0) DEFAULT 0, 
	"VALOR_TOTAL" NUMBER, 
	 PRIMARY KEY ("ID_INVESTIGADOR", "ID_PERICIA")
  USING INDEX  ENABLE
   ) ;

  ALTER TABLE "TB_INVESTIGADOR_PERICIA" ADD FOREIGN KEY ("ID_INVESTIGADOR")
	  REFERENCES "TB_INVESTIGADOR" ("ID_INVESTIGADOR") ON DELETE CASCADE ENABLE;
  ALTER TABLE "TB_INVESTIGADOR_PERICIA" ADD FOREIGN KEY ("ID_PERICIA")
	  REFERENCES "TB_PERICIA_BASE" ("ID_PERICIA") ENABLE;

