=========================
  TABELA INVESTIGADOR
=========================

CREATE TABLE "TB_INVESTIGADOR" 
   (	"ID_INVESTIGADOR" NUMBER GENERATED BY DEFAULT AS IDENTITY MINVALUE 1 MAXVALUE 9999999999999999999999999999 INCREMENT BY 1 START WITH 1 CACHE 20 NOORDER  NOCYCLE  NOKEEP  NOSCALE  NOT NULL ENABLE, 
	"NOME" VARCHAR2(100) NOT NULL ENABLE, 
	"OCUPACAO" VARCHAR2(100), 
	"IDADE" NUMBER, 
	"ATTR_FOR" NUMBER, 
	"ATTR_CON" NUMBER, 
	"ATTR_TAM" NUMBER, 
	"ATTR_DES" NUMBER, 
	"ATTR_APA" NUMBER, 
	"ATTR_INT" NUMBER, 
	"ATTR_POD" NUMBER, 
	"ATTR_EDU" NUMBER, 
	"SORTE_ATUAL" NUMBER, 
	"HP_MAX" NUMBER, 
	"HP_ATUAL" NUMBER, 
	"SAN_MAX" NUMBER, 
	"SAN_ATUAL" NUMBER, 
	"MP_MAX" NUMBER, 
	"MP_ATUAL" NUMBER, 
	"BONUS_DANO" VARCHAR2(10), 
	"CORPO" NUMBER, 
	"HISTORIA_PESSOAL" CLOB, 
	"FOTO_PERFIL" BLOB, 
	"FOTO_MIMETYPE" VARCHAR2(255), 
	"FOTO_FILENAME" VARCHAR2(255), 
	"DESCRICAO" VARCHAR2(4000), 
	"CARACTERISTICAS" VARCHAR2(4000), 
	"IDEOLOGIACRENCAS" VARCHAR2(4000), 
	"FERIMENTOS" VARCHAR2(4000), 
	"PESSOAS" VARCHAR2(4000), 
	"FOBIAS" VARCHAR2(4000), 
	"LOCAIS" VARCHAR2(4000), 
	"MAGIA" VARCHAR2(4000), 
	"PERTENCES" VARCHAR2(4000), 
	"ENCONTRO" VARCHAR2(4000), 
	"ID_JOGADOR" NUMBER, 
	 PRIMARY KEY ("ID_INVESTIGADOR")
  USING INDEX  ENABLE
   ) ;

  ALTER TABLE "TB_INVESTIGADOR" ADD CONSTRAINT "FK_INV_JOGADOR" FOREIGN KEY ("ID_JOGADOR")
	  REFERENCES "TB_JOGADOR" ("ID_JOGADOR") ENABLE;

=========================
TABELA INVESTIGADOR ARMA
=========================
  CREATE TABLE "TB_INVESTIGADOR_ARMA" 
   (	"ID_ARMA" NUMBER GENERATED BY DEFAULT AS IDENTITY MINVALUE 1 MAXVALUE 9999999999999999999999999999 INCREMENT BY 1 START WITH 1 CACHE 20 NOORDER  NOCYCLE  NOKEEP  NOSCALE  NOT NULL ENABLE, 
	"ID_INVESTIGADOR" NUMBER, 
	"NOME_ARMA" VARCHAR2(100) NOT NULL ENABLE, 
	"DANO" VARCHAR2(50), 
	"ALCANCE" VARCHAR2(50), 
